<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Under the hardened runtime macOS refuses to send Apple Events (music
       controls, browser tabs…) and never even prompts unless this is set.
       v0.2.0 shipped hardened-runtime-without-it, which broke every widget
       that talks to another app. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
