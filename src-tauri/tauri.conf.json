{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Cortex",
  "version": "0.2.1",
  "identifier": "dev.cortex.aio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Cortex",
        "width": 740,
        "height": 580,
        "minWidth": 600,
        "minHeight": 200,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "label": "main",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": "shell:open"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4NkNGQkQ1NzVERjlENkIKUldScm5kOTExZnRzNkxkVnBXMzJpWTI4cVFqZTcxSExWcTRUUjNFeFl6d3M3VmZWMVVZalMzbkUK",
      "endpoints": [
        "https://github.com/rayanjainn/aio/releases/latest/download/latest.json"
      ]
    }
  }
}
